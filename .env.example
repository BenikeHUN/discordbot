# Discord Developer Portal -> Applications -> Bot -> Token
DISCORD_TOKEN=
# Applications -> General Information -> Application ID
CLIENT_ID=
# Prefix for text commands, for example .play
PREFIX=.

# Optional. If set, slash commands register instantly on this one server.
# Leave empty to register globally (can take up to an hour to appear).
GUILD_ID=

# Optional overrides. Leave empty to use the bundled binaries.
YTDLP_PATH=
FFMPEG_PATH=

# Optional, and not needed for Spotify links to work. Spotify links are read
# from the public embed page, which needs no credentials. These are only a
# fallback for if that page ever changes shape.
# Create an app at https://developer.spotify.com/dashboard for the pair.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional. Path to a cookies.txt export, needed for age restricted videos
# or when YouTube asks the bot to prove it is not a robot.
YTDLP_COOKIES=

# Volume in percent that every new player starts at, and the ceiling users can
# set. Above 100 the signal is amplified, which can distort loud sources.
DEFAULT_VOLUME=100
MAX_VOLUME=200

# Milliseconds a volume change takes to ease across, instead of jumping.
# 0 applies it instantly.
VOLUME_RAMP_MS=1500

# A track opens at FADE_IN_FROM percent and eases up to the set volume over
# FADE_IN_MS, so a loud setting does not burst in. Only applies when the set
# volume is above FADE_IN_FROM; below that a track just opens at its level.
# FADE_IN_MS=0 turns the fade off.
FADE_IN_MS=1500
FADE_IN_FROM=50

# The now playing message is edited in place on every track change. Once this
# many other messages have arrived in the channel it is reposted at the bottom
# instead, so the controls do not stay buried. 0 reposts every time.
NOW_PLAYING_REPOST_AFTER=5

# Seconds to stay in the voice channel after the queue runs out. 0 disables.
LEAVE_TIMEOUT=120
