{
  "name": "discord-yt-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Discord music bot for YouTube, SoundCloud and anything else yt-dlp reaches",
  "main": "src/index.js",
  "scripts": {
