# npm 11.17 blocks dependency install scripts unless they are allow listed.
# Both of these need theirs: ffmpeg-static downloads the ffmpeg binary, and
# @discordjs/opus resolves its prebuilt native encoder where one exists.
allow-scripts=ffmpeg-static,@discordjs/opus

# Keep the console readable on a panel, where the install output is the first
# thing a user sees. None of what these print is actionable here: the funding
# and audit summaries, npm's own update notice, and deprecation notices for
# packages several levels down in someone else's dependency tree. Real failures
# are logged at error level and still come through.
audit=false
fund=false
update-notifier=false
loglevel=error
